{
  "name": "phone-mask",
  "version": "1.0.0",
  "description": "Vue 3 phone input with country-aware formatting, masks, flags, and SSR-safe selector.",
  "type": "module",
  "packageManager": "npm@10.9.4",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "dist/*.css"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/phone-mask.umd.cjs",
  "module": "dist/phone-mask.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/phone-mask.js",
      "require": "./dist/phone-mask.umd.cjs"
    },
    "./style.css": "./dist/phone-mask.css",
    "./PhoneMaskInput.vue": "./src/components/PhoneMaskInput.vue"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "build:pages": "vite build --config vite.pages.config.ts",
    "consumer:smoke:nuxt": "node scripts/consumer-smoke-nuxt.mjs",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts",
    "prepack": "npm run build",
    "release:check": "npm run format:check && npm run lint && npm run build && npm test && npm run test:e2e && npm run consumer:smoke:nuxt && npm run pack:dry-run",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "npm run lint:eslint && npm run lint:stylelint",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"src/**/*.{css,vue}\"",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc --noEmit",
    "test": "npm run typecheck && npm run test:unit"
  },
  "keywords": [
    "vue",
    "vue3",
    "phone",
    "phone-mask",
    "input",
    "libphonenumber",
    "nuxt",
    "ssr"
  ],
  "author": "Raferty",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raferty/phone-mask.git"
  },
  "bugs": {
    "url": "https://github.com/Raferty/phone-mask/issues"
  },
  "homepage": "https://raferty.github.io/phone-mask/",
  "dependencies": {
    "libphonenumber-js": "^1.12.42"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.2.1",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.5.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.8.3",
    "stylelint": "^17.9.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10",
    "vitest": "^3.2.4",
    "vue": "^3.5.33",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.7"
  }
}
